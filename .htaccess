<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent access to hidden files (except .well-known for SSL)
    RewriteRule ^(.*/)?\.(?!well-known)(.*)$ - [F,L]

    # Skip rewriting for existing files (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Static pages - Simple routing
    RewriteRule ^donations/?$ index.php?p=donations [L,QSA]
    RewriteRule ^login/?$ index.php?p=login [L,QSA]
    RewriteRule ^logout/?$ index.php?p=logout [L,QSA]
    RewriteRule ^coins/?$ index.php?p=coins [L,QSA]
    RewriteRule ^categories/?$ index.php?p=categories [L,QSA]
    RewriteRule ^settings/?$ index.php?p=settings [L,QSA]
    RewriteRule ^wishlist/?$ index.php?p=wishlist [L,QSA]
    RewriteRule ^search/?$ index.php?p=search [L,QSA]

    # Admin routes
    RewriteRule ^admin/paypal/?$ index.php?p=paypal [L,QSA]
    RewriteRule ^dashboard/?$ index.php?p=dashboard [L,QSA]

    # Category listing with ID
    RewriteRule ^category/([0-9]+)/?$ index.php?p=items&category=$1 [L,QSA]

    # Item detail with ID
    RewriteRule ^item/([0-9]+)/?$ index.php?p=item&id=$1 [L,QSA]

    # Add item to category
    RewriteRule ^add/item/([0-9]+)/?$ index.php?p=add_items&category=$1 [L,QSA]

    # Add bonus item to category
    RewriteRule ^add/bonus/item/([0-9]+)/?$ index.php?p=add_items_bonus&category=$1 [L,QSA]

    # Remove category
    RewriteRule ^remove/category/([0-9]+)/?$ index.php?p=categories&remove=$1 [L,QSA]

    # Remove item from category
    RewriteRule ^remove/item/([0-9]+)/([0-9]+)/?$ index.php?p=items&remove=$1&category=$2 [L,QSA]

    # Buy coins success/cancelled (PayPal returns)
    RewriteRule ^buy/coins/success/?$ index.php?p=coins&status=success [L,QSA]
    RewriteRule ^buy/coins/cancelled/?$ index.php?p=coins&status=cancelled [L,QSA]

    # Prevent direct access to include files
    RewriteRule ^include/ - [F,L]

    # Prevent access to SQLite database files
    RewriteRule \.(db|sqlite|sqlite3)$ - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Default charset UTF-8
AddDefaultCharset UTF-8

# PHP settings (if allowed)
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value max_execution_time 300
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>

# Compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
